# Google AI Studio key. The free tier is enough: https://aistudio.google.com/apikey
GOOGLE_API_KEY=

# Using a key from a Google Cloud project instead (billed to the project; Cloud trial credits apply
# here, not on the AI Studio route)? Uncomment, enable the Agent Platform API (formerly Vertex AI)
# and allow that API in the key's restrictions.
# GOOGLE_GENAI_USE_VERTEXAI=true

# Any "provider:model" accepted by LangChain's init_chat_model
LLM_MODEL=google_genai:gemini-3.8-flash

# Tried in order when the main model is overloaded (503) or out of free quota (429). Empty disables it.
LLM_FALLBACK_MODELS=google_genai:gemini-3.6-flash,google_genai:gemini-3.5-flash-lite,google_genai:gemini-3.1-flash-lite

# Gemini 3 reasoning effort: minimal | low | medium | high
LLM_THINKING=low

# Seconds per model request before giving up (and moving to the fallback)
LLM_TIMEOUT=30

# Optional: freeze the store clock (Campo Grande local time, ISO 8601)
# EMPORIO_NOW=2026-03-23T10:30
