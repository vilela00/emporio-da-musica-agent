# Google AI Studio key. The free tier is enough: https://aistudio.google.com/apikey
GOOGLE_API_KEY=

# Any "provider:model" accepted by LangChain's init_chat_model
LLM_MODEL=google_genai:gemini-3.8-flash

# Gemini 3 reasoning effort: minimal | low | medium | high
LLM_THINKING=low

# Optional: freeze the store clock (Campo Grande local time, ISO 8601)
# EMPORIO_NOW=2026-03-23T10:30
